# ─────────────────────────────────────────
# study 루트 .gitignore (하위 폴더 전체에 적용)
# ─────────────────────────────────────────

# IDE (모든 하위 폴더의 .idea 포함)
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# 가상환경 / 환경변수
.venv/
venv/
env/
ENV/
.env
.envrc

# Python 캐시 / 빌드
__pycache__/
*.py[codz]
*$py.class
*.so
*.egg-info/
*.egg
build/
dist/

# Jupyter
.ipynb_checkpoints/

# 테스트 / 린터 캐시
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# 로그 / DB
*.log
*.sqlite3
checkpoints.db

# 기타
tempCodeRunnerFile.py
.streamlit/secrets.toml

# 추가
docs/